# Kopiere diese Datei bei Bedarf nach yazio-overview.properties.
# Sie wird beim Start neben der JAR/EXE gesucht.

server.port=8080
yazio.data.dir=data
yazio.static.dir=static

# Expliziter Demo-Modus: keine Userverwaltung, keine echte Yazio-API.
yazio.demo.mode=false

# Normale Userverwaltung. Wird ignoriert, wenn yazio.demo.mode=true ist.
yazio.user.management=false
yazio.admin.password=admin

# Developer-Modus: zeigt den manuellen JSON-Import fuer Tests/Reparaturen.
developer=0
